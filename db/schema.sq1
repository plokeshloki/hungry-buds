-- Hungry Buds — Database Schema (Postgres / Supabase)
-- Run this in Supabase's SQL Editor (Project > SQL Editor > New query > paste > Run)

-- =========================================
-- 1. MENU ITEMS
-- =========================================
create table menu_items (
  id            uuid primary key default gen_random_uuid(),
  name          text not null,
  category      text not null,           -- 'Biryani', 'Combo', 'Breads', 'Beverages'
  veg           boolean not null,        -- true = veg, false = non-veg (drives the green/red dot)
  price         integer not null,        -- in paise-free rupees, e.g. 220 = ₹220
  mrp           integer,                 -- optional strikethrough price for combos
  photo_url     text,
  description   text,
  in_stock      boolean not null default true,
  is_combo      boolean not null default false,
  combo_items   jsonb,                   -- e.g. [{"item_id": "...", "qty": 2}]
  created_at    timestamptz not null default now(),
  updated_at    timestamptz not null default now()
);

-- =========================================
-- 2. ORDER WINDOWS (admin-editable time slots)
-- =========================================
create table order_windows (
  id            text primary key,       -- 'morning', 'evening'
  label         text not null,
  order_open    time not null,          -- e.g. '09:00'
  order_close   time not null,          -- e.g. '12:30'
  pickup_start  time not null,          -- e.g. '13:00'
  pickup_end    time not null,          -- e.g. '13:20'
  is_active     boolean not null default true,
  updated_at    timestamptz not null default now()
);

-- =========================================
-- 3. APP SETTINGS (single row — closed message, handling fee, etc.)
-- =========================================
create table app_settings (
  id                serial primary key,
  closed_message    text not null default 'Ordering is closed right now. Please check back during our next window!',
  handling_fee      integer not null default 5,   -- flat ₹ added at checkout
  updated_at        timestamptz not null default now()
);
insert into app_settings (closed_message, handling_fee) values
  ('Kitchen''s prepping for the next round — we''ll reopen soon!', 5);

-- =========================================
-- 4. CUSTOMERS (guest checkout — phone number only, no password)
-- =========================================
create table customers (
  id            uuid primary key default gen_random_uuid(),
  phone         text not null unique,   -- 10-digit Indian mobile, validated in app layer
  name          text,                   -- optional, collected at checkout
  created_at    timestamptz not null default now()
);

-- =========================================
-- 5. ORDERS
-- =========================================
create table orders (
  id                uuid primary key default gen_random_uuid(),
  customer_id       uuid not null references customers(id),
  order_window_id   text references order_windows(id),
  status            text not null default 'pending',
                    -- 'pending' | 'paid' | 'failed' | 'picked_up' | 'cancelled'
  subtotal          integer not null,     -- sum of menu prices, in ₹
  handling_fee      integer not null,     -- copied from app_settings at order time
  total_amount      integer not null,     -- subtotal + handling_fee, what customer actually paid
  razorpay_order_id     text,
  razorpay_payment_id   text,
  created_at        timestamptz not null default now()
);

-- =========================================
-- 6. ORDER ITEMS (line items per order)
-- =========================================
create table order_items (
  id            uuid primary key default gen_random_uuid(),
  order_id      uuid not null references orders(id) on delete cascade,
  menu_item_id  uuid not null references menu_items(id),
  item_name     text not null,   -- snapshot of the name at order time (in case menu changes later)
  unit_price    integer not null, -- snapshot of price at order time
  quantity      integer not null check (quantity > 0)
);

-- =========================================
-- 7. ADMIN USERS (single owner account, password + OTP)
-- =========================================
create table admin_users (
  id                uuid primary key default gen_random_uuid(),
  phone             text not null unique,
  password_hash     text not null,     -- bcrypt hash, never store plain text
  created_at        timestamptz not null default now()
);

-- =========================================
-- Helpful indexes
-- =========================================
create index idx_orders_customer on orders(customer_id);
create index idx_orders_created on orders(created_at);
create index idx_order_items_order on order_items(order_id);
create index idx_customers_phone on customers(phone);

-- =========================================
-- Seed the two default order windows (matches your original spec)
-- =========================================
insert into order_windows (id, label, order_open, order_close, pickup_start, pickup_end) values
  ('morning', 'Morning window', '09:00', '12:30', '13:00', '13:20'),
  ('evening', 'Evening window', '14:00', '18:30', '18:45', '19:15');
